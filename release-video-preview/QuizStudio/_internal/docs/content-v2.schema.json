{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 2
    },
    "title": {
      "type": "string"
    },
    "mode": {
      "enum": [
        "multiple_choice",
        "error_correction",
        "fill_blank",
        "word_order",
        "translation",
        "listening",
        "dialogue",
        "true_false",
        "multiple_meanings",
        "sentence_upgrade",
        "phrase_lesson",
        "mixed"
      ]
    },
    "settings": {
      "type": "object",
      "properties": {
        "thinking_seconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 30
        }
      },
      "required": []
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "$ref": "#/$defs/multiple_choice"
          },
          {
            "$ref": "#/$defs/error_correction"
          },
          {
            "$ref": "#/$defs/fill_blank"
          },
          {
            "$ref": "#/$defs/word_order"
          },
          {
            "$ref": "#/$defs/translation"
          },
          {
            "$ref": "#/$defs/listening"
          },
          {
            "$ref": "#/$defs/dialogue"
          },
          {
            "$ref": "#/$defs/true_false"
          },
          {
            "$ref": "#/$defs/multiple_meanings"
          },
          {
            "$ref": "#/$defs/sentence_upgrade"
          },
          {
            "$ref": "#/$defs/phrase_lesson"
          }
        ]
      }
    }
  },
  "required": [
    "schema_version",
    "items"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
