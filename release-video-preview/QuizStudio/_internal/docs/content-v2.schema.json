        "subject": {
          "type": "string",
          "minLength": 1
        },
        "prompt": {
          "type": "string",
          "minLength": 1
        },
        "thinking_seconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 30
        },
        "explanation": {
          "type": "string"
        },
        "question": {
          "type": "string",
          "minLength": 1
        },
        "options": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "answer": {
          "enum": [
            "A",
            "B",
            "C",
            "D"
          ]
        }
      },
      "required": [
        "type",
        "question",
        "options",
        "answer"
      ]
    },
